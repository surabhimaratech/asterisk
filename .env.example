# Required for Explore Concepts and Sidequests. Never commit your real key.
OPENROUTER_API_KEY=your-openrouter-api-key

# Configurable model with Structured Outputs support.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional provider settings.
OPENROUTER_TIMEOUT_SECONDS=30
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Research uses OpenRouter's billable web-search server tool. Exa is pinned for
# predictable source annotations; change only to another supported engine.
OPENROUTER_SEARCH_ENGINE=exa

# Evidence recovery is attempted only for candidates whose initial evidence fails.
# These hard limits bound the number of extra research/model calls and their
# estimated spend; they never lower the evidence quality gate.
EVIDENCE_RECOVERY_MAX_CANDIDATES=2
EVIDENCE_RECOVERY_MAX_SEARCH_RESULTS=4
EVIDENCE_RECOVERY_MAX_ESTIMATED_COST_USD=0.03
EVIDENCE_RECOVERY_ESTIMATED_COST_PER_CANDIDATE_USD=0.015
